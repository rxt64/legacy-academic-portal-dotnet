<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- Default for the test assembly: labs OFF. Individual tests toggle at runtime. -->
    <add key="ENABLE_VULNERABILITY_LABS" value="false" />
  </appSettings>
  <connectionStrings>
    <!-- Only used by the DB-gated integration tests, which run against a
         LOCAL instance created for this repository. Provide the password via
         the SIGEA_APP_PASSWORD environment variable; no secret is committed. -->
    <add name="SchoolContext"
         connectionString="Server=localhost;Database=SIGEA;User Id=sigea_app;Password=;TrustServerCertificate=True;MultipleActiveResultSets=True"
         providerName="System.Data.SqlClient" />
    <add name="LabReadOnlyContext"
         connectionString="Server=localhost;Database=SIGEA;User Id=sigea_labro;Password=;TrustServerCertificate=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
