<?xml version="1.0" encoding="utf-8"?>
<!--
  SIGEA - traditional ASP.NET MVC 5 configuration.

  NO SECRETS are committed here. The connection strings use integrated
  placeholders / env-substituted passwords; see Web.config.example and
  README.md. Replace ${...} with local-lab values via a deployment step or
  a Web.config transform; never commit filled-in credentials.
-->
<configuration>
  <configSections>
    <section name="entityFramework"
             type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089"
             requirePermission="false" />
  </configSections>

  <connectionStrings>
    <!-- Application runtime account: least-privilege SQL login 'sigea_app'. -->
    <add name="SchoolContext"
         connectionString="Server=localhost;Database=SIGEA;User Id=sigea_app;Password=${SIGEA_APP_PASSWORD};TrustServerCertificate=True;MultipleActiveResultSets=True"
         providerName="System.Data.SqlClient" />

    <!-- READ-ONLY account used ONLY by the SECURITY-LAB SQL-injection exercise
         (DOTNET-SQLI-01). SELECT-only login 'sigea_labro'. -->
    <add name="LabReadOnlyContext"
         connectionString="Server=localhost;Database=SIGEA;User Id=sigea_labro;Password=${SIGEA_LABRO_PASSWORD};TrustServerCertificate=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <!-- Vulnerability labs. DISABLED BY DEFAULT. The lab routes are only
         registered when this is exactly "true" (see RouteConfig) AND the
         request arrives over loopback (see LabGate). The environment name
         alone never enables them. -->
    <add key="ENABLE_VULNERABILITY_LABS" value="false" />
    <!-- Title shown in the portal header. -->
    <add key="PortalTitle" value="SIGEA — Portal Académico Interno v2.4" />
  </appSettings>

  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <globalization fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" />
    <!-- Request validation ON (normal screens). The XSS discussion for SIGEA
         is covered in GEPER; here the security labs are SQLi and IDOR. -->
    <authentication mode="None" />
    <sessionState mode="InProc" timeout="30" />
    <customErrors mode="RemoteOnly" />
  </system.web>

  <system.webServer>
    <modules runAllManagedModulesForAllRequests="true" />
    <!-- Bind to loopback for local lab use is handled by IIS Express config /
         launch settings; see README. -->
  </system.webServer>

  <entityFramework>
    <defaultConnectionFactory
        type="System.Data.Entity.Infrastructure.SqlConnectionFactory, EntityFramework" />
    <providers>
      <provider invariantName="System.Data.SqlClient"
                type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
    </providers>
  </entityFramework>

  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Mvc" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="0.0.0.0-5.2.9.0" newVersion="5.2.9.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Antlr3.Runtime" publicKeyToken="eb42632606e9261f" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-3.5.0.2" newVersion="3.5.0.2" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="WebGrease" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-1.6.5135.21930" newVersion="1.6.5135.21930" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
