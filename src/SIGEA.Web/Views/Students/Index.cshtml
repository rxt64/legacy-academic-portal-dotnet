@model System.Collections.Generic.IEnumerable<SIGEA.Web.Models.Student>
@{
    ViewBag.Title = "Estudiantes";
    ViewBag.Active = "students";
}
<h1 class="page">Estudiantes</h1>

<form method="get" action="@Url.Action("Index")" class="toolbar">
    <label style="min-width:auto">Buscar (apellido/nombre)</label>
    <input type="text" name="searchString" value="@ViewBag.SearchString" />
    <input type="submit" value="Buscar" />
    <a class="btn" href="@Url.Action("Create")">Nuevo estudiante</a>
</form>

<table class="grid">
    <tr><th>#</th><th>Apellidos</th><th>Nombre</th><th>Correo</th><th>Matrícula</th><th></th></tr>
    @foreach (var s in Model)
    {
        <tr>
            <td>@s.ID</td>
            <td>@Html.ActionLink(s.LastName, "Details", new { id = s.ID })</td>
            <td>@s.FirstName</td>
            <td>@s.Email</td>
            <td>@(s.EnrollmentDate.HasValue ? s.EnrollmentDate.Value.ToString("yyyy-MM-dd") : "")</td>
            <td>@Html.ActionLink("editar", "Edit", new { id = s.ID }) | @Html.ActionLink("eliminar", "Delete", new { id = s.ID })</td>
        </tr>
    }
</table>
