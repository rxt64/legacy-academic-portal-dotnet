@using SIGEA.Web.Infrastructure
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject LabGate LabGate
@{
    var portalTitle = Configuration["PortalTitle"]
                      ?? "SIGEA — Portal Académico Interno v2.4";
    var labsOn = LabGate.LabsConfigured;
    string active = ViewBag.Active as string;
    Func<string, string> cls = key => string.Equals(active, key) ? "active" : "";
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=1024" />
    <title>@ViewBag.Title - SIGEA</title>
    <link rel="stylesheet" href="@Url.Content("~/css/site.css")" />
</head>
<body>
<div class="container">
    <div class="header">
        <div class="emblem">ISVC</div>
        <div>
            <div class="title">@portalTitle</div>
            <div class="subtitle">Instituto Superior Valle Claro &middot; Aplicación ficticia de demostración</div>
        </div>
    </div>

    @if (labsOn)
    {
        <div class="lab-banner">&#9888; Laboratorio vulnerable activo &middot; Datos ficticios</div>
    }

    <div class="tabs">
        <a class="@cls("dashboard")" href="@Url.Action("Index", "Home")">Tablero</a>
        <a class="@cls("students")" href="@Url.Action("Index", "Students")">Estudiantes</a>
        <a class="@cls("instructors")" href="@Url.Action("Index", "Instructors")">Instructores</a>
        <a class="@cls("courses")" href="@Url.Action("Index", "Courses")">Cursos</a>
        <a class="@cls("departments")" href="@Url.Action("Index", "Departments")">Departamentos</a>
        <a class="@cls("enrollments")" href="@Url.Action("Index", "Enrollments")">Matrículas</a>
        <a class="@cls("account")" href="@Url.Action("Login", "Account")">Mi expediente</a>
        @if (labsOn)
        {
            <a class="lab @cls("lab")" href="@Url.Action("Index", "Lab")">Laboratorio</a>
        }
    </div>

    <div class="content">
        @if (TempData["Flash"] != null)
        {
            <div class="msg-mono">@TempData["Flash"]</div>
        }
        @RenderBody()
    </div>

    <div class="footer">
        Aplicación ficticia de demostración &middot; SIGEA v2.4 &middot; Instituto Superior Valle Claro (ficticio)
    </div>
</div>
</body>
</html>
