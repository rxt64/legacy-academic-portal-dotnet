@model SIGEA.Web.Models.TranscriptViewModel
@{ ViewBag.Title = "Lab IDOR"; ViewBag.Active = "lab"; }
<h1 class="page">SECURITY-LAB DOTNET-IDOR-01 — Verificación de propiedad (remediada)</h1>
<div class="msg-mono">Sesión autenticada como estudiante #@ViewBag.SessionStudentId. Expediente mostrado: #@Model.StudentID (@Model.StudentName).</div>
<p class="muted">Esta ruta ahora exige que <code>id</code> coincida con el estudiante autenticado en sesión,
   igual que la ruta normal <code>@Url.Action("Details","Transcript", new { id = ViewBag.SessionStudentId })</code>.
   Solicitar el expediente de otro estudiante (p. ej. <code>?id=8</code> estando autenticado como el #7) devuelve 403.</p>
<table class="grid">
    <tr><th>Curso</th><th class="right">Créditos</th><th class="right">Calificación</th></tr>
    @foreach (var l in Model.Lines)
    {
        <tr><td>@l.Title</td><td class="right">@l.Credits</td><td class="right">@(l.Grade.HasValue ? l.Grade.Value.ToString("0.00") : "(sin calificar)")</td></tr>
    }
</table>
<p>Promedio (GPA): <b>@(Model.Gpa.HasValue ? Model.Gpa.Value.ToString("0.00") : "-")</b></p>
<div class="toolbar">
    <a class="btn" href="@Url.Action("Transcript", new { id = ViewBag.SessionStudentId })">Ver mi propio expediente</a>
</div>

